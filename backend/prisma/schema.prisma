generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES_REP
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  CAMPAIGN
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  ARCHIVED
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  CHURNED
}

enum DealStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
  TASK_LOG
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role       @default(SALES_REP)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignedLeads   Lead[]     @relation("AssignedLeads")
  createdLeads    Lead[]     @relation("CreatedLeads")
  ownedCustomers  Customer[] @relation("OwnedCustomers")
  ownedDeals      Deal[]     @relation("OwnedDeals")
  activities      Activity[] @relation("UserActivities")
  assignedTasks   Task[]     @relation("AssignedTasks")
  createdTasks    Task[]     @relation("CreatedTasks")

  @@map("users")
}

model Lead {
  id                  String     @id @default(uuid())
  firstName           String
  lastName            String
  email               String
  phone               String?
  company             String?
  title               String?
  source              LeadSource @default(OTHER)
  status              LeadStatus @default(NEW)
  value               Float      @default(0)
  assignedToId        String?
  createdByUserId     String
  convertedAt         DateTime?
  convertedCustomerId String?
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  assignedTo        User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy         User       @relation("CreatedLeads", fields: [createdByUserId], references: [id])
  convertedCustomer Customer?  @relation("LeadConvertedToCustomer", fields: [convertedCustomerId], references: [id])
  customersOrigin   Customer[] @relation("CustomerConvertedFromLead")
  deals             Deal[]
  activities        Activity[]
  tasks             Task[]

  @@index([email])
  @@index([status])
  @@index([assignedToId])
  @@map("leads")
}

model Customer {
  id                  String         @id @default(uuid())
  name                String
  contactEmail        String
  contactPhone        String?
  industry            String?
  address             String?
  status              CustomerStatus @default(ACTIVE)
  ownerId             String
  convertedFromLeadId String?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner             User       @relation("OwnedCustomers", fields: [ownerId], references: [id])
  convertedFromLead Lead?      @relation("CustomerConvertedFromLead", fields: [convertedFromLeadId], references: [id])
  leadsConverted    Lead[]     @relation("LeadConvertedToCustomer")
  deals             Deal[]
  activities        Activity[]
  tasks             Task[]

  @@index([name])
  @@index([ownerId])
  @@map("customers")
}

model Deal {
  id                String    @id @default(uuid())
  title             String
  amount            Float     @default(0)
  stage             DealStage @default(QUALIFICATION)
  probability       Int       @default(10)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  customerId        String
  leadId            String?
  ownerId           String
  lostReason        String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead       Lead?      @relation(fields: [leadId], references: [id])
  owner      User       @relation("OwnedDeals", fields: [ownerId], references: [id])
  activities Activity[]
  tasks      Task[]

  @@index([stage])
  @@index([customerId])
  @@index([ownerId])
  @@map("deals")
}

model Activity {
  id           String       @id @default(uuid())
  type         ActivityType @default(NOTE)
  subject      String
  description  String?
  userId       String
  leadId       String?
  customerId   String?
  dealId       String?
  activityDate DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user     User      @relation("UserActivities", fields: [userId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
  @@map("activities")
}

model Task {
  id              String       @id @default(uuid())
  title           String
  description     String?
  dueDate         DateTime?
  priority        TaskPriority @default(MEDIUM)
  status          TaskStatus   @default(PENDING)
  assignedToId    String
  createdByUserId String
  leadId          String?
  customerId      String?
  dealId          String?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  assignedTo User      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy  User      @relation("CreatedTasks", fields: [createdByUserId], references: [id])
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([assignedToId])
  @@index([status])
  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
  @@map("tasks")
}

model TokenBlacklist {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("token_blacklist")
}
